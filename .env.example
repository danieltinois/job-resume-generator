# Copy to .env and fill in. Never commit .env: it holds secrets.
# Every value below is a placeholder.

# Signs access tokens. At least 32 bytes; generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes

# Public URL of the frontend, used in email links and the Google redirect.
APP_BASE_URL=http://localhost:4200

# false only for local HTTP; production must keep the refresh cookie Secure.
COOKIE_SECURE=false

# Proxies allowed to set X-Forwarded-For (a Java regex). Default: private and loopback ranges.
# TRUSTED_PROXIES=

# Swagger UI (/swagger-ui.html) and the OpenAPI spec (/v3/api-docs). Set false in production.
API_DOCS_ENABLED=true

DATABASE_URL=jdbc:postgresql://localhost:5432/resume
DATABASE_USERNAME=resume
DATABASE_PASSWORD=resume

# Mailpit (docker compose) in development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost

# Optional. Leave empty to offer password sign-in only.
# Authorized redirect URI: <backend URL>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
